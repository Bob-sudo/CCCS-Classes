        if (c == '+')
        {
            tokens.push_back(new PlusTok());
            i++;
        }
        else if (c == '-')
        {
            tokens.push_back(new MinusTok());
            i++;
        }
        else if (c == '*')
        {
            tokens.push_back(new MultTok());
            i++;
        }
        else if (c == '/')
        {
            tokens.push_back(new DivTok());
            i++;
        }
        else if (c == '(')
        {
            tokens.push_back(new LParenTok());
            i++;
        }
        else if (c == ')')
        {
            tokens.push_back(new RParenTok());
            i++;
        }
        else if (std::isdigit(c))
        {
            // Build a multi-digit integer manually
            int value = 0;
            while (i < (int)s.size() && std::isdigit(s[i]))
            {
                value = value * 10 + (s[i] - '0');
                i++;
            }
            tokens.push_back(new IntTok(value));
        }
        else
        {
            // Invalid character
            std::cerr << "ERROR: Unknown character '" << c << "'\n";
            i++;
        }
    }
}

